{
  "name": "alrecue-blog",
  "version": "1.0.0",
  "description": "Alrecue's Blog - GitHub Pages",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:server": "live-server --port=8080 --host=localhost --no-browser",
    "dev:scss": "sass --watch scss:css --style=expanded",
    "build": "npm run build:scss",
    "build:scss": "sass scss:css --style=compressed"
  },
  "keywords": [
    "blog",
    "hexo"
  ],
  "author": "Alrecue",
  "license": "MIT",
  "devDependencies": {
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.69.5"
  }
}
